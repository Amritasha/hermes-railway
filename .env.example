# ── LLM Provider (pick one) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=        # https://openrouter.ai — 200+ models, recommended

# ── Telegram Bot (required for gateway) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # from @BotFather on Telegram
TELEGRAM_ALLOWED_USERS=    # comma-separated Telegram user IDs (e.g. 123456789)
TELEGRAM_HOME_CHANNEL=     # chat ID for cron-triggered messages

# Railway auto-sets PORT; Hermes uses it for the webhook listener
# TELEGRAM_WEBHOOK_URL is set automatically by the start script using Railway's RAILWAY_PUBLIC_DOMAIN
# TELEGRAM_WEBHOOK_PORT is set from PORT in the Dockerfile

# ── Optional integrations ──────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=

# GITHUB_TOKEN=            # for skill installs and code tools
# EXA_API_KEY=             # AI web search
# FAL_KEY=                 # image generation
